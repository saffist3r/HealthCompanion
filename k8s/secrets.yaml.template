# Copy to secrets.yaml, fill values, then: kubectl apply -f k8s/secrets.yaml
# Do NOT commit secrets.yaml (see SECURITY.md).
apiVersion: v1
kind: Secret
metadata:
  name: healthcompanion-secrets
  namespace: healthcompanion
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CHANGE_ME_POSTGRES"
  # Must match POSTGRES_PASSWORD above
  DATABASE_URL: "postgresql://healthcompanion:CHANGE_ME_POSTGRES@postgres:5432/healthcompanion"
  # Required for meal photo AI — https://aistudio.google.com/apikey
  GEMINI_API_KEY: ""
  # JWT + bootstrap admin (created on first boot if no users exist)
  JWT_SECRET: "CHANGE_ME_LONG_RANDOM"
  ADMIN_EMAIL: "admin@example.com"
  ADMIN_PASSWORD: "CHANGE_ME_ADMIN"
  ADMIN_NAME: "Admin"
  # Daily PDF report email (optional — leave blank to disable)
  SMTP_HOST: ""
  SMTP_PORT: "465"
  SMTP_SSL: "true"
  SMTP_USER: ""
  SMTP_PASSWORD: ""
  REPORT_EMAIL_TO: ""
  REPORT_EMAIL_FROM: ""
  REPORT_EMAIL_FROM_NAME: "Health Companion"
  PUBLIC_URL: "https://healthcompanion.example.com"
