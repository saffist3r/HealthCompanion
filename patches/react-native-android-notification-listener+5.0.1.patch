+            try {
+                java.lang.reflect.Field f = RemoteViews.class.getDeclaredField(nestedField);
+                f.setAccessible(true);
+                Object nested = f.get(rv);
+                if (nested instanceof RemoteViews) {
+                    result.addAll(getRemoteViewActionsRecursive((RemoteViews) nested, depth + 1));
+                }
+            } catch (Exception e) { /* ignore */ }
+        }
+        try {
+            java.lang.reflect.Field f = RemoteViews.class.getDeclaredField("mSizedRemoteViews");
+            f.setAccessible(true);
+            Object raw = f.get(rv);
+            if (raw instanceof List) {
+                for (Object item : (List<?>) raw) {
+                    if (item instanceof RemoteViews) {
+                        result.addAll(getRemoteViewActionsRecursive((RemoteViews) item, depth + 1));
+                    }
+                }
+            }
+        } catch (Exception e) { /* ignore */ }
