{
  "expo": {
    "name": "Health Companion",
    "slug": "health-companion",
    "version": "1.7.0",
    "scheme": "healthcompanion",
    "orientation": "portrait",
    "icon": "./assets/health-companion-logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saffist3r.healthcompanion"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#0B1220"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.saffist3r.healthcompanion",
      "versionCode": 70,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withHealthCompanionWear",
      "./plugins/withSamsungHealth",
      "./plugins/withHealthConnectSetup",
      "./plugins/withAllowBackupReplace",
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00E5FF",
          "defaultChannel": "morning-checkin"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Health Companion to photograph meals and pick watch background images.",
          "cameraPermission": "Allow Health Companion to photograph meals for nutrition analysis."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Health Companion to talk live with Reb3i about your diabetes day."
        }
      ],
      "expo-video"
    ]
  }
}
